# Copy to .env to override the local-only demo defaults used by docker-compose.yml.
# These are throwaway passwords for a laptop demo; nothing here is a real credential.
BSA_ADMIN_PASSWORD=local-admin-change-me
BSA_WRITER_PASSWORD=local-writer-change-me
BSA_READER_PASSWORD=local-reader-change-me
BSA_API_PORT=18080
# Folder containing telemetry.csv and reference_capacity.csv produced by scripts/convert_nasa.py
BSA_DATA_DIR=./data
# Dockerfile = build jars inside Docker; Dockerfile.prebuilt = reuse jars from target/
BSA_DOCKERFILE=Dockerfile
